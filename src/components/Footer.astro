---
import Logo from "./Logo.astro";

const productLinks = [
  { href: "/#features", label: "Fonctionnalités" },
  { href: "/#security", label: "Sécurité" },
  { href: "/tarifs", label: "Tarifs" },
  { href: "/inscription", label: "Inscrire mon asso" },
  { href: "/#faq", label: "FAQ" },
];
const legalLinks = [
  { href: "/confidentialite", label: "Confidentialité" },
  { href: "/conditions", label: "Conditions" },
  { href: "/sous-traitance", label: "Sous-traitance" },
  { href: "/suppression-compte", label: "Suppression de compte" },
  { href: "/mentions-legales", label: "Mentions légales" },
];

const year = new Date().getFullYear();
const linkCls = "text-graphite/80 transition-colors hover:text-graphite hover:underline underline-offset-2";
---

<footer class="bg-mist px-5 text-[13px] text-slate sm:px-6">
  <div class="mx-auto max-w-[1080px] pt-12 pb-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2 text-[15px] font-semibold tracking-[-0.01em] text-graphite">
          <Logo class="h-6 w-6" />
          Konclav
        </a>
        <p class="mt-3 max-w-[260px] leading-relaxed">L'intranet privé pensé pour les associations suisses.</p>
      </div>

      <nav aria-label="Produit">
        <p class="font-semibold text-graphite">Produit</p>
        <ul class="mt-3 space-y-2.5">
          {productLinks.map((l) => <li><a href={l.href} class={linkCls}>{l.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Liens légaux">
        <p class="font-semibold text-graphite">Légal</p>
        <ul class="mt-3 space-y-2.5">
          {legalLinks.map((l) => <li><a href={l.href} class={linkCls}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <p class="font-semibold text-graphite">Contact</p>
        <ul class="mt-3 space-y-2.5">
          <li><a href="mailto:contact@konclav.ch" class={linkCls}>contact@konclav.ch</a></li>
          <li>
            <a href="/espace" rel="nofollow" class={`inline-flex items-center gap-1.5 ${linkCls}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              Espace client
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Konclav. Tous droits réservés.</p>
      <p class="inline-flex items-center gap-1.5">
        <svg viewBox="0 0 32 32" class="h-3 w-3 rounded-[2px]" aria-hidden="true">
          <rect width="32" height="32" fill="#DA291C" />
          <rect x="13" y="6" width="6" height="20" fill="#fff" />
          <rect x="6" y="13" width="20" height="6" fill="#fff" />
        </svg>
        Fait en Suisse
      </p>
    </div>
  </div>
</footer>
