---
import Logo from "./Logo.astro";
// Modal "Rejoignez Konclav" — wizard multi-étapes qui POSTe en JSON vers
// l'Edge Function Supabase website-lead-submit (projet Zurich) :
// insert dans public.leads + mail récap à contact@konclav.ch via Resend.
const FORM_ACTION =
  "https://ehbdngidjrkhfrprfgqg.supabase.co/functions/v1/website-lead-submit";

const cantons = ["Valais", "Vaud", "Fribourg", "Genève", "Neuchâtel", "Jura", "Autre"];
const legalForms = ["Asso suisse", "Asso loi 1901", "Asbl belge", "Club/Collectif", "ONG/Fondation", "Autre"];
const memberCounts = ["Moins de 10", "10-30", "30-100", "100-300", "Plus de 300"];
const roles = ["Président", "Vice-président", "Secrétaire", "Trésorier", "Membre du comité", "Autre"];
const sources = ["Recommandation", "Recherche Google/réseaux", "LinkedIn", "Presse", "Bouche-à-oreille", "Autre"];
const modules = ["Tâches", "Calendrier", "Documents", "Annuaire", "Cotisations", "Notes de frais", "AG/votations", "Forum", "Liens", "Pas décidé"];

const steps = [
  { n: 1, title: "Votre association", sub: "Parlez-nous de votre structure." },
  { n: 2, title: "Votre contact", sub: "Qui est notre interlocuteur principal ?" },
  { n: 3, title: "Pour mieux vous orienter", sub: "Optionnel, mais ça nous aide à mieux vous répondre." },
  { n: 4, title: "Dernière étape", sub: "On y est presque." },
];

const inputCls =
  "w-full rounded-xl border border-hairline bg-white px-4 py-3 text-[15px] text-graphite placeholder:text-ash transition-[border-color,box-shadow] focus:border-graphite focus:outline-none focus:ring-4 focus:ring-black/[0.06]";
const labelCls = "mb-2 block text-[15px] font-medium text-graphite";
const optionCls =
  "relative flex cursor-pointer items-center gap-3 rounded-xl border border-hairline bg-white px-4 py-3 text-[15px] text-graphite transition-[border-color,box-shadow] hover:border-ash has-[:checked]:border-graphite has-[:checked]:ring-1 has-[:checked]:ring-graphite has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand-600";
const radioIndCls =
  "relative h-[18px] w-[18px] shrink-0 rounded-full border border-ash transition-colors after:absolute after:inset-0 after:m-auto after:h-1.5 after:w-1.5 after:rounded-full after:bg-white after:opacity-0 peer-checked:border-graphite peer-checked:bg-graphite peer-checked:after:opacity-100";
const checkIndCls =
  "relative h-[18px] w-[18px] shrink-0 rounded-md border border-ash transition-colors after:absolute after:left-1/2 after:top-[45%] after:h-[9px] after:w-[5px] after:-translate-x-1/2 after:-translate-y-1/2 after:rotate-45 after:border-b-2 after:border-r-2 after:border-white after:opacity-0 peer-checked:border-graphite peer-checked:bg-graphite peer-checked:after:opacity-100";
const errCls = "join-error mt-1.5 text-[13px] text-[#d70015]";
const req = '<span class="text-brand-600">*</span>';
---

<div
  data-join-modal
  data-action={FORM_ACTION}
  inert
  class="join-modal fixed inset-0 z-[100] hidden"
  aria-hidden="true"
>
  <div data-join-backdrop class="absolute inset-0 bg-black/30 backdrop-blur-md"></div>

  <div class="absolute inset-0 flex items-start justify-center overflow-y-auto p-3 sm:items-center sm:p-6">
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="join-title"
      class="join-panel relative my-auto w-full max-w-lg rounded-[28px] bg-white shadow-[0_40px_120px_-24px_rgba(0,0,0,0.4)]"
    >
      <button
        type="button"
        data-join-close
        aria-label="Fermer"
        class="absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-mist text-slate transition-colors hover:bg-cloud hover:text-graphite"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
          <path d="M6 6l12 12M18 6l-12 12" />
        </svg>
      </button>

      <div class="px-6 pt-7 pb-5 sm:px-8">
        <div class="flex items-center gap-2 pr-12">
          <Logo class="h-6 w-6" />
          <span id="join-title" class="text-[15px] font-semibold tracking-[-0.01em] text-graphite">Rejoignez Konclav</span>
        </div>
        <div class="mt-5 flex items-center justify-between text-[13px] text-slate">
          <span data-join-steplabel class="font-medium text-graphite">Étape 1 / {steps.length}</span>
          <span>Réponse sous 48h</span>
        </div>
        <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-mist">
          <div data-join-progress class="h-full rounded-full bg-graphite transition-[width] duration-500 ease-out" style="width: 25%;"></div>
        </div>
        <p class="mt-4 text-[12px] leading-snug text-slate">
          Vos réponses sont stockées <strong class="font-semibold text-graphite">en Suisse</strong> (notre base de
          données à Zurich) et servent uniquement à qualifier votre demande —
          pas de marketing, pas de revente. Détails et droits dans
          la <a href="/confidentialite" class="underline hover:text-graphite">politique de confidentialité</a>.
        </p>
      </div>

      <form data-join-form novalidate class="border-t border-hairline px-6 py-6 sm:px-8">
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
          <label>Laissez ce champ vide
            <input type="text" name="website" tabindex="-1" autocomplete="off" data-join-hp />
          </label>
        </div>

        <!-- ÉTAPE 1 -->
        <div data-step class="join-step space-y-5">
          <header>
            <h3 class="text-[22px] font-semibold tracking-[-0.016em] text-graphite">{steps[0].title}</h3>
            <p class="mt-1 text-[15px] text-slate">{steps[0].sub}</p>
          </header>

          <div data-field data-required>
            <label class={labelCls} for="f-assoName">Nom de l'association <Fragment set:html={req} /></label>
            <input id="f-assoName" type="text" name="asso_name" autocomplete="organization" required aria-required="true" class={inputCls} placeholder="Ex : FC Lausanne" />
            <p role="alert" class={errCls}>Ce champ est obligatoire.</p>
          </div>

          <div data-field data-required>
            <label class={labelCls} id="canton-label">Canton <Fragment set:html={req} /></label>
            <div data-custom-select class="relative">
              <select name="canton" tabindex="-1" aria-hidden="true" class="sr-only">
                <option value="" selected disabled>Choisissez…</option>
                {cantons.map((c) => <option value={c}>{c}</option>)}
              </select>
              <button
                type="button"
                data-cs-trigger
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-required="true"
                aria-labelledby="canton-label"
                class={`${inputCls} flex items-center justify-between pr-10 text-left`}
              >
                <span data-cs-value class="text-ash">Choisissez…</span>
              </button>
              <svg viewBox="0 0 16 16" fill="none" class="cs-chevron pointer-events-none absolute bottom-0 right-3.5 top-0 my-auto h-4 w-4 text-slate transition-transform duration-200" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <ul
                data-cs-list
                role="listbox"
                aria-labelledby="canton-label"
                hidden
                class="absolute z-30 mt-2 max-h-60 w-full overflow-y-auto rounded-2xl border border-hairline bg-white p-1.5 shadow-[0_20px_50px_-12px_rgba(0,0,0,0.25)]"
              >
                {cantons.map((c) => (
                  <li
                    role="option"
                    data-cs-option
                    data-value={c}
                    tabindex="-1"
                    aria-selected="false"
                    class="group flex cursor-pointer items-center justify-between gap-2 rounded-xl px-3 py-2.5 text-[15px] text-graphite transition-colors hover:bg-mist focus:bg-mist focus:outline-none aria-selected:bg-mist aria-selected:font-medium"
                  >
                    <span>{c}</span>
                    <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0 text-brand-600 opacity-0 transition-opacity group-aria-selected:opacity-100" aria-hidden="true">
                      <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </li>
                ))}
              </ul>
            </div>
            <p role="alert" class={errCls}>Merci de choisir un canton.</p>
          </div>

          <div data-field>
            <span class={labelCls}>Forme juridique</span>
            <div role="group" aria-label="Forme juridique" class="grid grid-cols-2 gap-2">
              {legalForms.map((opt) => (
                <label class={optionCls}>
                  <input type="radio" name="legal_form" value={opt} class="peer sr-only" />
                  <span class={radioIndCls}></span>
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div data-field data-required>
            <span class={labelCls}>Nombre de membres actifs <Fragment set:html={req} /></span>
            <div role="group" aria-label="Nombre de membres actifs" class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {memberCounts.map((opt) => (
                <label class={optionCls}>
                  <input type="radio" name="member_count" value={opt} class="peer sr-only" />
                  <span class={radioIndCls}></span>
                  <span>{opt}</span>
                </label>
              ))}
            </div>
            <p role="alert" class={errCls}>Merci de sélectionner une option.</p>
          </div>

          <div data-field data-required>
            <label class={labelCls} for="f-activity">Que fait votre association ? <Fragment set:html={req} /></label>
            <textarea id="f-activity" name="activity" rows="3" required aria-required="true" class={inputCls} placeholder="Ex : Théâtre, échecs, défense animale…"></textarea>
            <p role="alert" class={errCls}>Ce champ est obligatoire.</p>
          </div>
        </div>

        <!-- ÉTAPE 2 -->
        <div data-step hidden class="join-step space-y-5">
          <header>
            <h3 class="text-[22px] font-semibold tracking-[-0.016em] text-graphite">{steps[1].title}</h3>
            <p class="mt-1 text-[15px] text-slate">{steps[1].sub}</p>
          </header>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div data-field data-required>
              <label class={labelCls} for="f-firstName">Prénom <Fragment set:html={req} /></label>
              <input id="f-firstName" type="text" name="first_name" autocomplete="given-name" required aria-required="true" class={inputCls} />
              <p role="alert" class={errCls}>Obligatoire.</p>
            </div>
            <div data-field data-required>
              <label class={labelCls} for="f-lastName">Nom <Fragment set:html={req} /></label>
              <input id="f-lastName" type="text" name="last_name" autocomplete="family-name" required aria-required="true" class={inputCls} />
              <p role="alert" class={errCls}>Obligatoire.</p>
            </div>
          </div>

          <div data-field data-required>
            <label class={labelCls} for="f-email">Email <Fragment set:html={req} /></label>
            <input id="f-email" type="email" name="email" autocomplete="email" required aria-required="true" class={inputCls} placeholder="vous@votre-asso.ch" />
            <p role="alert" class={errCls}>Merci d'indiquer un email valide.</p>
          </div>

          <div data-field data-required>
            <span class={labelCls}>Rôle dans l'association <Fragment set:html={req} /></span>
            <div role="group" aria-label="Rôle dans l'association" class="grid grid-cols-2 gap-2">
              {roles.map((opt) => (
                <label class={optionCls}>
                  <input type="radio" name="role" value={opt} class="peer sr-only" />
                  <span class={radioIndCls}></span>
                  <span>{opt}</span>
                </label>
              ))}
            </div>
            <p role="alert" class={errCls}>Merci de sélectionner votre rôle.</p>
          </div>

          <div data-field>
            <label class={labelCls} for="f-phone">Téléphone <span class="font-normal text-slate">(optionnel)</span></label>
            <input id="f-phone" type="tel" name="phone" autocomplete="tel" class={inputCls} placeholder="+41 …" />
          </div>
        </div>

        <!-- ÉTAPE 3 -->
        <div data-step hidden class="join-step space-y-5">
          <header>
            <h3 class="text-[22px] font-semibold tracking-[-0.016em] text-graphite">{steps[2].title}</h3>
            <p class="mt-1 text-[15px] text-slate">{steps[2].sub}</p>
          </header>

          <div data-field>
            <span class={labelCls}>Comment avez-vous connu Konclav ?</span>
            <div role="group" aria-label="Comment avez-vous connu Konclav ?" class="grid grid-cols-2 gap-2">
              {sources.map((opt) => (
                <label class={optionCls}>
                  <input type="radio" name="source" value={opt} class="peer sr-only" />
                  <span class={radioIndCls}></span>
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div data-field>
            <span class={labelCls}>Modules envisagés en priorité</span>
            <div role="group" aria-label="Modules envisagés en priorité" class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {modules.map((opt) => (
                <label class={optionCls}>
                  <input type="checkbox" name="modules" value={opt} class="peer sr-only" />
                  <span class={checkIndCls}></span>
                  <span>{opt}</span>
                </label>
              ))}
            </div>
          </div>

          <div data-field>
            <label class={labelCls} for="f-needs">Besoins particuliers ou questions <span class="font-normal text-slate">(optionnel)</span></label>
            <textarea id="f-needs" name="needs" rows="3" maxlength="1000" class={inputCls} placeholder="Dites-nous tout…"></textarea>
          </div>
        </div>

        <!-- ÉTAPE 4 -->
        <div data-step hidden class="join-step space-y-5">
          <header>
            <h3 class="text-[22px] font-semibold tracking-[-0.016em] text-graphite">{steps[3].title}</h3>
            <p class="mt-1 text-[15px] text-slate">{steps[3].sub}</p>
          </header>

          <div data-field>
            <p class="rounded-2xl bg-mist p-4 text-[15px] leading-snug text-graphite">
              En envoyant ce formulaire, vous nous demandez d'être recontacté
              par e-mail au sujet de votre inscription. Aucun e-mail marketing ne
              vous sera adressé sans consentement séparé.
            </p>
          </div>

          <p class="text-[13px] leading-relaxed text-slate">
            Vos réponses servent uniquement à qualifier votre demande. Aucun email
            marketing, aucune revente. Elles sont stockées en Suisse (Supabase,
            Zurich) ; une notification nous parvient par e-mail via Resend.
            Détails et droits dans notre <a
              href="/confidentialite" class="text-brand-600 underline underline-offset-2"
              >politique de confidentialité</a
            >. Vous pouvez demander la suppression à tout moment.
          </p>
        </div>

        <!-- Navigation -->
        <div class="mt-7 flex items-center justify-between gap-3">
          <button type="button" data-join-prev hidden class="btn btn-secondary">
            <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Précédent
          </button>
          <div class="flex-1"></div>
          <button type="button" data-join-next class="btn btn-primary">
            Suivant
            <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5" aria-hidden="true"><path d="m6 3.5 4.5 4.5L6 12.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
          <button type="submit" data-join-submit hidden class="btn btn-primary">
            <span data-join-submit-label>Envoyer la demande</span>
          </button>
        </div>
        <p data-join-error role="alert" hidden class="mt-4 text-center text-[15px] text-[#d70015]">
          L'envoi a échoué. Réessayez, ou écrivez-nous à <a href="mailto:contact@konclav.ch" class="underline">contact@konclav.ch</a>.
        </p>
      </form>

      <!-- Succès -->
      <div data-join-success hidden class="border-t border-hairline px-6 py-12 text-center sm:px-8">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-mist text-brand-500">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8" aria-hidden="true"><path d="m5 13 4 4L19 7" /></svg>
        </div>
        <h3 class="mt-6 text-[24px] font-semibold tracking-[-0.016em] text-graphite">Demande envoyée !</h3>
        <p class="mx-auto mt-2 max-w-sm text-[15px] leading-relaxed text-slate">
          Merci. On étudie votre demande et on revient vers vous sous 48h ouvrées.
        </p>
        <button type="button" data-join-close class="btn btn-secondary mt-8">Fermer</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.querySelector("[data-join-modal]");
    if (!modal) return;

    const form = modal.querySelector("[data-join-form]");
    const stepEls = Array.from(modal.querySelectorAll("[data-step]"));
    const prevBtn = modal.querySelector("[data-join-prev]");
    const nextBtn = modal.querySelector("[data-join-next]");
    const submitBtn = modal.querySelector("[data-join-submit]");
    const submitLabel = modal.querySelector("[data-join-submit-label]");
    const progress = modal.querySelector("[data-join-progress]");
    const stepLabel = modal.querySelector("[data-join-steplabel]");
    const successEl = modal.querySelector("[data-join-success]");
    const backdrop = modal.querySelector("[data-join-backdrop]");
    const panel = modal.querySelector(".join-panel");
    const ACTION = modal.dataset.action;

    let current = 0;
    let lastFocused = null;

    function setStep(i) {
      current = Math.max(0, Math.min(i, stepEls.length - 1));
      stepEls.forEach((s, idx) => {
        s.hidden = idx !== current;
      });
      const pct = ((current + 1) / stepEls.length) * 100;
      if (progress) progress.style.width = pct + "%";
      if (stepLabel) stepLabel.textContent = "Étape " + (current + 1) + " / " + stepEls.length;
      prevBtn.hidden = current === 0;
      nextBtn.hidden = current === stepEls.length - 1;
      submitBtn.hidden = current !== stepEls.length - 1;
      if (panel) panel.scrollIntoView({ block: "nearest" });
      const first = stepEls[current].querySelector("input:not([type=radio]):not([type=checkbox]), select, textarea, input");
      if (first) setTimeout(() => first.focus({ preventScroll: true }), 60);
    }

    function validateStep(i) {
      let firstInvalid = null;
      stepEls[i].querySelectorAll("[data-field]").forEach((field) => {
        if (!field.hasAttribute("data-required")) {
          field.removeAttribute("data-invalid");
          return;
        }
        const text = field.querySelector('input[type="text"], input[type="email"], input[type="tel"], textarea, select');
        const radios = field.querySelectorAll('input[type="radio"]');
        const checks = field.querySelectorAll('input[type="checkbox"]');
        let ok = false;
        if (text) ok = text.value.trim() !== "" && text.checkValidity();
        else if (radios.length) ok = Array.from(radios).some((r) => r.checked);
        else if (checks.length) ok = Array.from(checks).some((c) => c.checked);
        const ctrl = text || (radios.length ? radios[0] : null) || (checks.length ? checks[0] : null);
        if (ok) {
          field.removeAttribute("data-invalid");
          if (ctrl) ctrl.removeAttribute("aria-invalid");
        } else {
          field.setAttribute("data-invalid", "");
          if (ctrl) ctrl.setAttribute("aria-invalid", "true");
          if (!firstInvalid) firstInvalid = field;
        }
      });
      if (firstInvalid) {
        firstInvalid.scrollIntoView({ behavior: "smooth", block: "center" });
        const f = firstInvalid.querySelector("[data-cs-trigger]") || firstInvalid.querySelector("input, select, textarea");
        if (f) setTimeout(() => f.focus({ preventScroll: true }), 220);
      }
      return !firstInvalid;
    }

    function closeMobileMenu() {
      const menuPanel = document.querySelector("[data-menu-panel]");
      if (menuPanel && !menuPanel.classList.contains("hidden")) {
        menuPanel.classList.add("hidden");
        menuPanel.setAttribute("inert", "");
        menuPanel.setAttribute("aria-hidden", "true");
        const mt = document.querySelector("[data-menu-toggle]");
        if (mt) mt.setAttribute("aria-expanded", "false");
      }
    }

    function openModal() {
      lastFocused = document.activeElement;
      closeMobileMenu();
      form.hidden = false;
      successEl.hidden = true;
      modal.classList.remove("hidden");
      modal.removeAttribute("inert");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      setStep(0);
    }
    function closeModal() {
      modal.classList.add("hidden");
      modal.setAttribute("inert", "");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    document.querySelectorAll("[data-join-open]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        // Stop the mobile drawer's own click handler from also running
        // (it would reset body overflow and unlock background scroll).
        e.stopImmediatePropagation();
        openModal();
      });
    });
    modal.querySelectorAll("[data-join-close]").forEach((b) => b.addEventListener("click", closeModal));
    backdrop && backdrop.addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => {
      if (modal.classList.contains("hidden")) return;
      if (e.key === "Escape") { closeModal(); return; }
      if (e.key === "Tab") {
        const sel = 'a[href], button:not([disabled]), input:not([disabled]):not([type=hidden]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
        const f = Array.from(panel.querySelectorAll(sel)).filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (!f.includes(document.activeElement)) { e.preventDefault(); first.focus(); return; }
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    nextBtn.addEventListener("click", () => {
      if (validateStep(current)) setStep(current + 1);
    });
    prevBtn.addEventListener("click", () => setStep(current - 1));

    // Custom dark dropdown(s) — backed by a hidden native <select>
    modal.querySelectorAll("[data-custom-select]").forEach((cs) => {
      const select = cs.querySelector("select");
      const trigger = cs.querySelector("[data-cs-trigger]");
      const valueEl = cs.querySelector("[data-cs-value]");
      const list = cs.querySelector("[data-cs-list]");
      const opts = Array.from(cs.querySelectorAll("[data-cs-option]"));
      const placeholder = valueEl.textContent;

      const openList = () => {
        list.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        const sel = opts.find((o) => o.getAttribute("aria-selected") === "true") || opts[0];
        sel.scrollIntoView({ block: "nearest" });
      };
      const closeList = () => {
        list.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
      };
      const choose = (opt) => {
        select.value = opt.dataset.value;
        valueEl.textContent = opt.dataset.value;
        valueEl.classList.remove("text-ash");
        opts.forEach((o) => o.setAttribute("aria-selected", String(o === opt)));
        select.dispatchEvent(new Event("change", { bubbles: true }));
        closeList();
        trigger.focus();
      };

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        if (list.hidden) openList();
        else closeList();
      });
      opts.forEach((opt) => opt.addEventListener("click", () => choose(opt)));
      document.addEventListener("click", (e) => {
        if (!cs.contains(e.target)) closeList();
      });
      trigger.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openList();
          (opts.find((o) => o.getAttribute("aria-selected") === "true") || opts[0]).focus();
        }
      });
      list.addEventListener("keydown", (e) => {
        const i = opts.indexOf(document.activeElement);
        if (e.key === "ArrowDown") { e.preventDefault(); (opts[i + 1] || opts[0]).focus(); }
        else if (e.key === "ArrowUp") { e.preventDefault(); (opts[i - 1] || opts[opts.length - 1]).focus(); }
        else if (e.key === "Enter" || e.key === " ") { e.preventDefault(); if (i > -1) choose(opts[i]); }
        else if (e.key === "Escape") { e.stopPropagation(); closeList(); trigger.focus(); }
      });
    });

    // Clear a field's error as soon as it's edited
    form.addEventListener("input", (e) => {
      const field = e.target.closest("[data-field]");
      if (field) field.removeAttribute("data-invalid");
    });
    form.addEventListener("change", (e) => {
      const field = e.target.closest("[data-field]");
      if (field) field.removeAttribute("data-invalid");
    });

    const errorEl = modal.querySelector("[data-join-error]");
    const hp = form.querySelector("[data-join-hp]");

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!validateStep(current)) return;

      // Honeypot rempli = bot : on simule le succès sans rien envoyer.
      if (hp && hp.value) { showSuccess(); return; }

      submitBtn.disabled = true;
      if (errorEl) errorEl.hidden = true;
      if (submitLabel) submitLabel.textContent = "Envoi…";

      const fd = new FormData(form);
      const payload = {};
      fd.forEach((value, key) => {
        if (key === "modules") return;
        payload[key] = value;
      });
      const mods = fd.getAll("modules");
      if (mods.length) payload.modules = mods;

      fetch(ACTION, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then((res) => {
          if (!res.ok) throw new Error("HTTP " + res.status);
          showSuccess();
        })
        .catch(() => {
          submitBtn.disabled = false;
          if (submitLabel) submitLabel.textContent = "Envoyer la demande";
          if (errorEl) errorEl.hidden = false;
        });
    });

    function showSuccess() {
      form.hidden = true;
      successEl.hidden = false;
      if (progress) progress.style.width = "100%";
      if (stepLabel) stepLabel.textContent = "Terminé";
      if (window.konclavTrack) window.konclavTrack("join-submit");
    }
  })();
</script>
