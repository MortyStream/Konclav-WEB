---
const steps = [
  {
    title: "Demande",
    description: "Vous remplissez un court formulaire — votre asso, vos outils actuels, vos contraintes. On répond sous 48h ouvrées.",
    duration: "5 min",
  },
  {
    title: "Provisionnement",
    description: "On crée votre espace, on configure vos rôles, on importe vos membres existants (CSV ou copier-coller).",
    duration: "48 h",
  },
  {
    title: "Go live",
    description: "Formation d'une heure avec votre comité, support dédié les premiers jours. Vos membres reçoivent leur accès.",
    duration: "7 jours",
  },
];
---

<section id="onboarding" class="bg-mist px-5 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-[820px] text-center">
    <p data-reveal class="t-eyebrow">Démarrage</p>
    <h2 data-reveal style="transition-delay: 60ms" class="t-section mt-3 text-balance text-graphite">De zéro à go live en 7 jours.</h2>
    <p data-reveal style="transition-delay: 120ms" class="t-lead mx-auto mt-5 max-w-[560px] text-pretty text-slate">
      Pas d'installation, pas de migration douloureuse. On vous accompagne pas à pas.
    </p>
  </div>

  <ol class="mx-auto mt-14 grid max-w-[1080px] gap-5 sm:mt-16 lg:grid-cols-3">
    {steps.map((step, i) => (
      <li data-reveal style={`transition-delay: ${i * 110}ms`} class="flex flex-col rounded-[28px] bg-white p-8 sm:p-10">
        <span class="text-[56px] font-semibold leading-none tracking-[-0.04em] text-brand-500 tabular-nums" aria-hidden="true">
          {i + 1}
        </span>
        <h3 class="mt-6 text-[24px] font-semibold tracking-[-0.016em] text-graphite">
          <span class="sr-only">Étape {i + 1} : </span>{step.title}
        </h3>
        <p class="mt-2 text-[15px] leading-relaxed text-slate sm:text-base">{step.description}</p>
        <p class="mt-auto flex items-center gap-2 pt-8 text-sm font-medium text-graphite">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="h-4 w-4 text-brand-500" aria-hidden="true">
            <circle cx="8" cy="8" r="6" />
            <path d="M8 4.5V8l2 1.5" />
          </svg>
          <span class="tabular-nums">{step.duration}</span>
        </p>
      </li>
    ))}
  </ol>
</section>
