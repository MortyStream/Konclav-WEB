---
// Bouton pilule façon Apple. variant "link" = lien texte avec chevron (« En savoir plus › »).
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "light" | "link";
  size?: "sm" | "md" | "lg";
  joinOpen?: boolean;
  class?: string;
}

const { href, variant = "primary", size = "md", joinOpen = false, class: extraClass = "" } = Astro.props;

const sizeClass = size === "sm" ? "btn-sm" : size === "lg" ? "px-7 py-3.5" : "";
const cls = variant === "link" ? "link-chevron" : `btn btn-${variant} ${sizeClass}`;
---

<a href={href} data-join-open={joinOpen ? "" : undefined} class={`${cls} ${extraClass}`}>
  <slot />
  {variant === "link" && (
    <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
      <path d="m6 3.5 4.5 4.5L6 12.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</a>
