---
import CTAButton from "./CTAButton.astro";
---

<section id="contact" class="px-5 pb-24 sm:px-6 sm:pb-32">
  <div data-reveal class="tile mx-auto max-w-[1080px] px-6 py-20 text-center sm:px-12 sm:py-28">
    <p data-content-key="cta_final.eyebrow" class="t-eyebrow">On se cale ?</p>
    <h2 data-content-key="cta_final.title" class="t-section mx-auto mt-3 max-w-[760px] text-balance text-graphite">
      Prêt à inscrire votre asso ?
    </h2>
    <p data-content-key="cta_final.subtitle" class="t-lead mx-auto mt-5 max-w-[560px] text-pretty text-slate">
      Un court formulaire pour nous présenter votre asso. On étudie chaque
      demande et on revient vers vous sous 48h ouvrées.
    </p>
    <div class="mt-9 flex flex-col items-center justify-center gap-x-8 gap-y-5 sm:flex-row">
      <CTAButton href="/inscription" joinOpen size="lg">S'inscrire</CTAButton>
      <CTAButton href="mailto:contact@konclav.ch" variant="link">Écrire un mail</CTAButton>
    </div>
    <p class="mt-8 text-sm text-slate">Réponse sous 48h ouvrées · En français · Sans engagement</p>
  </div>
</section>
