---
import PhoneShot from "./PhoneShot.astro";

// Tuiles façon Apple : texte centré en haut, iPhone qui sort du bas de la tuile
// et remonte au scroll (.sd-rise). Grille 6 colonnes : 3+3 puis 2+2+2.
const tiles = [
  {
    tab: "Tâches",
    title: "Des tâches qui passent par une validation.",
    desc: "Assignez, fixez une échéance, suivez l'avancement. Et pour les dépenses, un vrai circuit d'approbation : chaque achat passe par un responsable avant d'être engagé.",
    src: "/app/feat-taches.webp",
    alt: "Konclav — détail d'une tâche avec circuit de validation Approuver / Rejeter",
    span: "lg:col-span-3",
  },
  {
    tab: "Calendrier",
    title: "Tous les événements, par équipe.",
    desc: "Vues mois, semaine et jour. Entraînements, répétitions, matchs ou réunions — chaque événement avec son lieu et ses participants.",
    src: "/app/feat-calendrier.webp",
    alt: "Konclav — calendrier de l'association, vue mois",
    span: "lg:col-span-3",
  },
  {
    tab: "Annuaire",
    title: "Qui fait quoi, en un coup d'œil.",
    desc: "Tous les membres, leurs rôles et leurs pôles au même endroit. Le comité voit qui s'est connecté et qui reste à intégrer.",
    src: "/app/feat-annuaire.webp",
    alt: "Konclav — annuaire des membres avec rôles et pôles",
    span: "lg:col-span-2",
    narrow: true,
  },
  {
    tab: "Documents",
    title: "Statuts, PV, contrats — classés par pôle.",
    desc: "La mémoire de l'association au même endroit. Comité, sportif, communication, logistique : chacun son espace, recherche instantanée.",
    src: "/app/feat-documents.webp",
    alt: "Konclav — documents et dossiers classés par pôle",
    span: "lg:col-span-2",
    narrow: true,
  },
  {
    tab: "Cotisations & finances",
    title: "La trésorerie, sans tableur.",
    desc: "Cotisations encaissées, frais remboursés, balance de l'année — en direct. Le trésorier voit ce qu'il reste à recouvrer et les notes à traiter, sans ouvrir Excel.",
    src: "/app/feat-finances.webp",
    alt: "Konclav — tableau de bord financier : balance, cotisations, frais remboursés",
    span: "md:col-span-2 lg:col-span-2",
    narrow: true,
  },
];

const ag = {
  desc: "Démarrez une AG : les membres confirment leur présence par signature électronique, votent les ordres du jour, et le procès-verbal est archivé — horodaté et conservé.",
  points: ["Signature électronique de présence", "Votations en direct", "PV archivé automatiquement"],
};
---

<section id="features" class="px-5 pt-24 pb-24 sm:px-6 sm:pt-32 sm:pb-32">
  <div class="mx-auto max-w-[820px] text-center">
    <p data-reveal class="t-eyebrow">Fonctionnalités</p>
    <h2 data-reveal style="transition-delay: 60ms" class="t-section mt-3 text-balance text-graphite">
      Toute votre asso, écran par écran.
    </h2>
    <p data-reveal style="transition-delay: 120ms" class="t-lead mx-auto mt-5 max-w-[620px] text-pretty text-slate">
      Tâches, agenda, annuaire, documents, finances, assemblées — chaque
      espace de l'app, pensé pour le quotidien d'une association.
    </p>
  </div>

  <div class="mx-auto mt-14 grid max-w-[1080px] grid-cols-1 gap-5 sm:mt-16 md:grid-cols-2 lg:grid-cols-6">
    {
      tiles.map((t, i) => (
        <article
          data-reveal
          style={`transition-delay: ${(i % 3) * 80}ms`}
          class={`tile flex flex-col ${t.span}`}
        >
          <div class="px-7 pt-10 text-center sm:px-10 sm:pt-12">
            <p class="text-[15px] font-semibold text-brand-600">{t.tab}</p>
            <h3 class={`t-tile mx-auto mt-2 max-w-[420px] text-balance text-graphite ${t.narrow ? "lg:text-[26px]" : ""}`}>{t.title}</h3>
            <p class="mx-auto mt-4 max-w-[440px] text-pretty text-[15px] leading-relaxed text-slate sm:text-base">{t.desc}</p>
          </div>
          <div class="flex justify-center pt-10">
            <div class="sd-rise">
              <PhoneShot
                src={t.src}
                alt={t.alt}
                class="[--dw:min(270px,62cqw)] [margin-bottom:calc(var(--dw)*-0.78)]"
              />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<!-- AG — bande sombre, mise en scène produit -->
<section aria-labelledby="ag-title" class="relative overflow-hidden bg-night px-5 py-24 sm:px-6 sm:py-32">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[58%] -z-0 h-[560px] w-[760px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-40 blur-3xl"
    style="background: radial-gradient(closest-side, rgba(232,87,42,0.55), transparent 72%);"
  >
  </div>

  <div class="relative mx-auto max-w-[900px] text-center">
    <p data-reveal class="t-eyebrow !text-brand-300">AG & signatures</p>
    <h2 id="ag-title" data-reveal style="transition-delay: 60ms" class="t-section mt-3 text-balance text-white">
      L'assemblée générale, <span class="text-gradient-brand-night">dans votre poche.</span>
    </h2>
    <p data-reveal style="transition-delay: 120ms" class="t-lead mx-auto mt-6 max-w-[660px] text-pretty text-[#a1a1a6]">
      {ag.desc}
    </p>
  </div>

  <div data-reveal style="transition-delay: 160ms" class="relative mx-auto mt-16 max-w-[900px] [container-type:inline-size] sm:mt-20">
    <div class="flex items-center justify-center">
      <div class="sd-spread-l relative z-0 -mr-[7cqw] opacity-80">
        <PhoneShot
          src="/app/feat-ag-votation.webp"
          alt="Konclav — AG en cours : présence, quorum et votation Pour / Contre / Blanc en direct"
          class="[--dw:min(250px,33cqw)]"
        />
      </div>
      <div class="relative z-10">
        <PhoneShot
          src="/app/feat-ag.webp"
          alt="Konclav — écran réunions / AG avec PV archivé"
          class="[--dw:min(300px,40cqw)]"
        />
      </div>
      <div class="sd-spread-r relative z-0 -ml-[7cqw] opacity-80">
        <PhoneShot
          src="/app/feat-ag-election.webp"
          alt="Konclav — élections de l'AG : scrutin pour un poste avec candidats et vote blanc"
          class="[--dw:min(250px,33cqw)]"
        />
      </div>
    </div>
  </div>

  <ul data-reveal class="relative mx-auto mt-14 flex max-w-[900px] flex-wrap justify-center gap-x-10 gap-y-4 sm:mt-16">
    {ag.points.map((pt) => (
      <li class="flex items-center gap-2.5 text-[17px] text-[#e8e8ed]">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-brand-300" aria-hidden="true">
          <path d="m3.5 8.5 3 3 6-7" />
        </svg>
        {pt}
      </li>
    ))}
  </ul>
</section>
