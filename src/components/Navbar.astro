---
import CTAButton from "./CTAButton.astro";
import Logo from "./Logo.astro";

const links = [
  { href: "/#features", label: "Fonctionnalités" },
  { href: "/#security", label: "Sécurité" },
  { href: "/tarifs", label: "Tarifs" },
  { href: "/#faq", label: "FAQ" },
];
---

<header data-nav class="nav-glass fixed inset-x-0 top-0 z-50">
  <nav class="mx-auto flex h-[52px] max-w-[1080px] items-center justify-between px-5 sm:px-6" aria-label="Navigation principale">
    <a href="/" class="flex items-center gap-2 text-[17px] font-semibold tracking-[-0.01em] text-graphite">
      <Logo class="h-7 w-7" />
      Konclav
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={Astro.url.pathname === link.href ? "page" : undefined}
              class="text-[13.5px] text-graphite/75 transition-colors hover:text-graphite aria-[current=page]:text-graphite"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden md:block">
      <CTAButton href="/inscription" joinOpen size="sm">S'inscrire</CTAButton>
    </div>

    <button
      type="button"
      data-menu-toggle
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-full text-graphite transition-colors hover:bg-black/5 md:hidden"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
        <path d="M4 9h16M4 15h16" />
      </svg>
    </button>
  </nav>
</header>

<!-- Menu mobile plein écran -->
<div
  id="mobile-menu"
  data-menu-panel
  inert
  aria-hidden="true"
  class="fixed inset-0 z-[60] hidden bg-white/95 backdrop-blur-xl"
>
  <div class="flex h-[52px] items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2 text-[17px] font-semibold tracking-[-0.01em] text-graphite">
      <Logo class="h-7 w-7" />
      Konclav
    </a>
    <button
      type="button"
      data-menu-close
      aria-label="Fermer le menu"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-full text-graphite transition-colors hover:bg-black/5"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
        <path d="M6 6l12 12M18 6l-12 12" />
      </svg>
    </button>
  </div>

  <nav class="px-8 pt-6" aria-label="Navigation mobile">
    <ul class="flex flex-col">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={Astro.url.pathname === link.href ? "page" : undefined}
              class="block py-2.5 text-[28px] font-semibold tracking-[-0.02em] text-graphite"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-10">
      <CTAButton href="/inscription" joinOpen size="lg" class="w-full">S'inscrire</CTAButton>
    </div>
  </nav>
</div>
