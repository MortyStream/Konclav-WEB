---
// Cadre iPhone. La largeur se règle par --dw (prop `width` en px, ou classe CSS
// qui pose --dw avec min()/cqw pour un rendu fluide). Hauteur via aspect-ratio.
interface Props {
  src: string;
  alt: string;
  width?: number;
  priority?: boolean;
  reveal?: boolean;
  delay?: number;
  class?: string;
}

const { src, alt, width, priority = false, reveal = false, delay = 0, class: cls = "" } = Astro.props;

const style = [width ? `--dw: ${width}px` : "", delay ? `transition-delay: ${delay}ms` : ""].filter(Boolean).join("; ");
---

<div class={`device ${cls}`} style={style || undefined} data-reveal={reveal ? "" : undefined}>
  <div class="device__frame">
    <div class="device__screen">
      <img
        src={src}
        alt={alt}
        width="720"
        height="1560"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
        class="h-full w-full object-cover object-top"
      />
      <div class="device__island" aria-hidden="true"></div>
    </div>
  </div>
</div>
