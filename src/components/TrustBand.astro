---
const badges = [
  { label: "Conçu en Suisse", sub: "Pensé en Suisse romande", icon: "ch" },
  { label: "Conforme LPD & RGPD", sub: "Suisse et UE", icon: "shield" },
  { label: "Sans engagement", sub: "Résiliable au mois", icon: "globe" },
  { label: "Chiffré AES-256", sub: "Au repos, en transit", icon: "lock" },
];
---

<section aria-label="Garanties techniques et conformité" class="px-5 sm:px-6">
  <ul class="mx-auto grid max-w-[1080px] grid-cols-2 gap-x-6 gap-y-8 border-y border-hairline/70 py-10 sm:grid-cols-4">
    {badges.map((b, i) => (
      <li data-reveal style={`transition-delay: ${i * 70}ms`} class="flex flex-col items-center text-center">
        <span class="flex h-9 w-9 items-center justify-center text-brand-500">
          {b.icon === "ch" && (
            <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
              <rect width="32" height="32" rx="6" fill="#DA291C" />
              <rect x="13" y="7" width="6" height="18" fill="#fff" />
              <rect x="7" y="13" width="18" height="6" fill="#fff" />
            </svg>
          )}
          {b.icon === "shield" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7" aria-hidden="true">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          )}
          {b.icon === "globe" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a14.5 14.5 0 0 1 0 20a14.5 14.5 0 0 1 0-20" />
              <path d="M2 12h20" />
            </svg>
          )}
          {b.icon === "lock" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7" aria-hidden="true">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          )}
        </span>
        <p class="mt-3 text-[15px] font-semibold tracking-[-0.01em] text-graphite">{b.label}</p>
        <p class="mt-0.5 text-[13px] text-slate">{b.sub}</p>
      </li>
    ))}
  </ul>
</section>
