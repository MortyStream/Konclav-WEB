---
import PhoneShot from "./PhoneShot.astro";
// Hero : trois iPhone droits, le central devant. Tailles en cqw → la composition
// se met à l'échelle de son conteneur, sans JS. Zoom léger lié au scroll (.sd-zoom).
---

<div class="mx-auto w-full max-w-[900px] [container-type:inline-size]">
  <div class="sd-zoom flex items-end justify-center [transform-origin:50%_100%]">
    <PhoneShot
      src="/app/agenda-semaine.webp"
      alt="Konclav — agenda, vue semaine des entraînements"
      class="relative z-0 -mr-[9cqw] translate-y-[5%] [--dw:min(250px,37cqw)]"
    />
    <PhoneShot
      src="/app/accueil.webp"
      alt="Konclav — écran d'accueil : accès rapides aux tâches, agenda, annuaire et documents"
      priority
      class="relative z-10 [--dw:min(300px,46cqw)]"
    />
    <PhoneShot
      src="/app/documents.webp"
      alt="Konclav — documents et dossiers de l'association"
      class="relative z-0 -ml-[9cqw] translate-y-[5%] [--dw:min(250px,37cqw)]"
    />
  </div>
</div>
