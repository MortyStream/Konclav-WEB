---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  heading: string;
  updated: string;
  noindex?: boolean;
}

const { title, description, heading, updated, noindex = false } = Astro.props;
---

<Layout title={title} description={description} noindex={noindex}>
  <Navbar />
  <main id="main">
    <section class="px-5 pt-[120px] pb-12 sm:px-6 sm:pt-[150px] sm:pb-14">
      <div class="mx-auto max-w-[760px]">
        <p data-reveal class="t-eyebrow">Pages légales</p>
        <h1 data-reveal style="transition-delay: 60ms" class="mt-3 text-balance text-[clamp(2.25rem,5vw,3.25rem)] font-semibold leading-[1.08] tracking-[-0.022em] text-graphite">
          {heading}
        </h1>
        <p data-reveal style="transition-delay: 100ms" class="mt-4 text-[15px] text-slate">
          Dernière mise à jour : {updated}
        </p>
      </div>
    </section>

    <section class="px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="prose-legal mx-auto max-w-[760px] border-t border-hairline pt-10 text-[17px] leading-[1.65] text-slate">
        <slot />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose-legal h2 {
    margin-top: 3rem;
    margin-bottom: 0.875rem;
    color: var(--color-graphite);
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.016em;
  }
  .prose-legal h2:first-child {
    margin-top: 0;
  }
  .prose-legal h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--color-graphite);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .prose-legal p {
    margin-bottom: 1rem;
  }
  .prose-legal ul {
    margin: 1rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-legal ul li {
    margin-bottom: 0.5rem;
  }
  .prose-legal ul li::marker {
    color: var(--color-ash);
  }
  .prose-legal a {
    color: var(--color-brand-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose-legal a:hover {
    color: var(--color-graphite);
  }
  .prose-legal strong {
    color: var(--color-graphite);
    font-weight: 600;
  }
  .prose-legal hr {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-hairline);
  }
  .prose-legal blockquote {
    margin: 1.5rem 0;
    border-radius: 18px;
    background: var(--color-mist);
    padding: 1.1rem 1.35rem;
    font-size: 1rem;
    color: var(--color-graphite);
  }
  .prose-legal blockquote p:last-child {
    margin-bottom: 0;
  }
  .prose-legal table {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .prose-legal th,
  .prose-legal td {
    border-bottom: 1px solid var(--color-hairline);
    padding: 0.7rem 0.85rem;
    text-align: left;
    vertical-align: top;
  }
  .prose-legal th {
    color: var(--color-graphite);
    font-weight: 600;
    background: var(--color-mist);
    white-space: nowrap;
  }
  .prose-legal code {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.85em;
    padding: 0.15rem 0.4rem;
    border-radius: 0.4rem;
    background: var(--color-mist);
    color: var(--color-graphite);
  }
</style>
