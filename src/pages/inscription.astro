---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PhoneShot from "../components/PhoneShot.astro";
import CTAButton from "../components/CTAButton.astro";

const screens = [
  { src: "/app/tache.webp", alt: "Konclav — détail d'une tâche avec validation" },
  { src: "/app/agenda-semaine.webp", alt: "Konclav — agenda, vue semaine des entraînements" },
  { src: "/app/agenda-mois.webp", alt: "Konclav — agenda, vue mois" },
  { src: "/app/documents.webp", alt: "Konclav — documents et dossiers de l'association" },
  { src: "/app/statuts.webp", alt: "Konclav — statuts et règlements" },
  { src: "/app/annuaire.webp", alt: "Konclav — annuaire des membres et rôles" },
  { src: "/app/association.webp", alt: "Konclav — espace association : cotisations, notes de frais" },
];

const captions = [
  {
    label: "Tâches & validations",
    description: "Kanban, attribution, deadlines — et un circuit de validation pour les dépenses.",
  },
  {
    label: "Agenda partagé",
    description: "Vues mois et semaine, événements par équipe, lieux et participants.",
  },
  {
    label: "Documents",
    description: "Statuts, PV, contrats, règlements — classés par pôle, recherche instantanée.",
  },
  {
    label: "Vie associative",
    description: "Annuaire et rôles, cotisations, notes de frais, sondages, réunions.",
  },
];
---

<Layout
  title="Inscrire mon asso — Konclav"
  description="Konclav en images. Présentez-nous votre association pour demander un accès — on étudie chaque demande sous 48h ouvrées."
>
  <Navbar />
  <main id="main">
    <section class="px-5 pt-[120px] pb-14 sm:px-6 sm:pt-[156px] sm:pb-16">
      <div class="mx-auto max-w-[900px] text-center">
        <p data-reveal class="t-eyebrow">Inscription</p>
        <h1 data-reveal style="transition-delay: 60ms" class="t-hero mt-3 text-balance text-graphite">
          Toute la vie associative, dans une seule app.
        </h1>
        <p data-reveal style="transition-delay: 120ms" class="t-lead mx-auto mt-6 max-w-[620px] text-pretty text-slate">
          Découvrez Konclav en images. Si l'app vous parle, présentez-nous
          votre asso — on étudie chaque demande pour s'assurer que Konclav
          vous correspond.
        </p>
        <div data-reveal style="transition-delay: 180ms" class="mt-9 flex flex-col items-center justify-center gap-x-8 gap-y-5 sm:flex-row">
          <CTAButton href="/inscription" joinOpen size="lg">S'inscrire</CTAButton>
          <CTAButton href="#reserver" variant="link">Comment ça se passe</CTAButton>
        </div>
      </div>
    </section>

    <!-- Galerie d'écrans -->
    <section aria-label="Écrans de l'application" class="bg-mist py-16 sm:py-20">
      <div
        data-reveal
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-6 pt-2 no-scrollbar sm:gap-8 sm:px-6 [&>*]:snap-center"
      >
        {
          screens.map((s, i) => (
            <PhoneShot src={s.src} alt={s.alt} priority={i < 3} class="[--dw:232px] sm:[--dw:260px]" />
          ))
        }
      </div>
      <p class="mt-4 flex items-center justify-center gap-1.5 text-[13px] font-medium text-slate" aria-hidden="true">
        Glissez pour explorer les écrans
        <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5"><path d="m6 3.5 4.5 4.5L6 12.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </p>

      <div class="mx-auto mt-12 grid max-w-[1080px] gap-x-8 gap-y-8 px-5 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
        {
          captions.map((c, i) => (
            <div data-reveal style={`transition-delay: ${i * 80}ms`} class="text-center sm:text-left">
              <p class="text-[17px] font-semibold tracking-[-0.01em] text-graphite">{c.label}</p>
              <p class="mt-1.5 text-[15px] leading-relaxed text-slate">{c.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Demande d'accès -->
    <section id="reserver" class="px-5 py-24 sm:px-6 sm:py-32">
      <div class="mx-auto max-w-[900px] text-center">
        <p data-reveal class="t-eyebrow">Inscrire mon asso</p>
        <h2 data-reveal style="transition-delay: 60ms" class="t-section mt-3 text-balance text-graphite">Présentez-nous votre asso.</h2>
        <p data-reveal style="transition-delay: 120ms" class="t-lead mx-auto mt-5 max-w-[600px] text-pretty text-slate">
          Un court formulaire pour qu'on s'assure que Konclav vous
          correspond. On revient vers vous sous 48h ouvrées avec un accès
          ou une réponse argumentée.
        </p>

        <ul data-reveal class="mx-auto mt-12 grid max-w-[820px] gap-3 text-left sm:grid-cols-3">
          {[
            "Taille et nature de votre asso",
            "Vos outils actuels et leurs limites",
            "Vos contraintes (budget, RGPD, etc.)",
          ].map((item) => (
            <li class="flex items-start gap-3 rounded-[18px] bg-mist p-5">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" />
              </svg>
              <span class="text-[15px] leading-snug text-graphite">{item}</span>
            </li>
          ))}
        </ul>

        <div data-reveal class="mt-12 flex flex-col items-center gap-4">
          <a href="mailto:contact@konclav.ch?subject=Inscription%20Konclav" data-join-open class="btn btn-primary px-7 py-3.5">
            S'inscrire
          </a>
          <p class="text-[13px] text-slate">2 minutes · Réponse sous 48h ouvrées · Sans engagement</p>
        </div>

        <p data-reveal class="mt-10 text-[15px] text-slate">
          Vous préférez écrire directement ?{" "}
          <a href="mailto:contact@konclav.ch?subject=Demande%20d%27acc%C3%A8s%20Konclav" class="font-medium text-brand-600 hover:underline">
            contact@konclav.ch
          </a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
