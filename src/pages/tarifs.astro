---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import PriceSimulator from "../components/PriceSimulator.astro";
import CTAButton from "../components/CTAButton.astro";

const plans = [
  {
    name: "Konclav",
    tagline: "Pour les associations de toutes tailles.",
    price: "4 CHF",
    priceUnit: "/ membre actif / mois",
    floor: "Forfait minimum 39 CHF / mois",
    featured: true,
    cta: { href: "/inscription", label: "S'inscrire", joinOpen: true },
    features: [
      "Tâches Kanban illimitées",
      "Agenda partagé multi-équipes",
      "Documents (PV, statuts, contrats)",
      "Notifications push mobile",
      "Membres et rôles illimités",
      "Support par email sous 48h ouvrées",
    ],
  },
  {
    name: "Sur mesure",
    tagline: "Fédérations, grandes structures, besoins spécifiques.",
    price: "Sur devis",
    priceUnit: "",
    floor: "Dès 100 membres ou besoins custom",
    featured: false,
    cta: { href: "mailto:contact@konclav.ch?subject=Konclav%20Sur%20mesure", label: "Nous écrire" },
    features: [
      "Tout ce qui est dans Konclav",
      "Onboarding personnalisé",
      "Engagement annuel négociable",
      "Support prioritaire",
    ],
  },
];

const included = [
  {
    icon: "shield-check" as const,
    title: "Hébergé en Suisse",
    description: "Données applicatives hébergées chez Supabase Zurich.",
  },
  {
    icon: "eye-off" as const,
    title: "Sans pub",
    description: "Pas de Google Analytics, pas de pixels publicitaires, pas de revente de données.",
  },
  {
    icon: "lock" as const,
    title: "Chiffré au repos",
    description: "Sauvegardes quotidiennes chiffrées. Export de vos données sur simple demande.",
  },
  {
    icon: "hard-drive" as const,
    title: "Sans engagement",
    description: "Résiliable au mois. Pas de frais cachés, pas de surfacturation au volume.",
  },
];

const faq = [
  {
    q: "Qu'est-ce qu'un « membre actif » ?",
    a: "Toute personne qui s'est connectée au moins une fois dans le mois. Les comptes inactifs ne sont pas facturés.",
  },
  {
    q: "Comment se passe le paiement ?",
    a: "Facturation mensuelle, par virement bancaire, sur la base du nombre de membres actifs du mois écoulé. L'éditeur n'étant pas assujetti à la TVA (CA inférieur au seuil de 100 000 CHF), les prix s'entendent nets et aucune TVA n'est facturée.",
  },
  {
    q: "Y a-t-il une période d'essai ?",
    a: "Oui — 14 jours gratuits, sans carte bancaire. Aucune relance si vous ne souhaitez pas continuer.",
  },
  {
    q: "Faites-vous des tarifs réduits ?",
    a: "Pour les petites assos (<10 membres), un tarif solidaire existe. Écrivez-nous, on en discute.",
  },
];
---

<Layout
  title="Tarifs — Konclav"
  description="Un tarif simple, pensé pour les associations. 4 CHF par membre actif par mois. Sans engagement, hébergé en Suisse."
>
  <Navbar />
  <main id="main">
    <section class="px-5 pt-[120px] pb-12 sm:px-6 sm:pt-[156px] sm:pb-16">
      <div class="mx-auto max-w-[900px] text-center">
        <p data-reveal class="t-eyebrow">Tarifs</p>
        <h1 data-reveal style="transition-delay: 60ms" class="t-hero mt-3 text-balance text-graphite">
          Un prix simple, pensé pour les assos.
        </h1>
        <p data-reveal style="transition-delay: 120ms" class="t-lead mx-auto mt-6 max-w-[620px] text-pretty text-slate">
          4 CHF par <em class="not-italic font-medium text-graphite">membre actif</em> par mois.
          Un membre actif, c'est une personne qui s'est connectée au moins
          une fois dans le mois — les comptes dormants ne sont jamais
          facturés.
        </p>
      </div>
    </section>

    <!-- Pack fondateurs -->
    <section class="px-5 pb-8 sm:px-6">
      <div data-reveal class="mx-auto flex max-w-[900px] flex-col items-center gap-3 rounded-[20px] bg-mist px-6 py-5 text-center sm:flex-row sm:gap-4 sm:text-left">
        <span class="inline-flex shrink-0 items-center rounded-full bg-graphite px-3 py-1 text-[12px] font-semibold text-white">Pack fondateurs</span>
        <p class="text-[15px] leading-relaxed text-slate">
          Les <strong class="font-semibold text-graphite">5 premières associations</strong> bénéficient de
          <strong class="font-semibold text-graphite">−50% pendant 6 mois</strong>, en échange d'un
          retour d'expérience publiable.
          <a href="/inscription" data-join-open class="whitespace-nowrap font-medium text-brand-600 hover:underline">Je candidate ›</a>
        </p>
      </div>
    </section>

    <!-- Plans -->
    <section class="px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="mx-auto grid max-w-[900px] gap-5 md:grid-cols-2">
        {
          plans.map((plan, i) => (
            <article
              data-reveal
              style={`transition-delay: ${i * 100}ms`}
              class={`relative flex flex-col rounded-[28px] p-8 sm:p-10 ${plan.featured ? "bg-white ring-2 ring-graphite" : "bg-mist"}`}
            >
              {plan.featured && (
                <span class="absolute right-7 top-7 rounded-full bg-mist px-3 py-1 text-[12px] font-semibold text-graphite">Recommandé</span>
              )}
              <h2 class="text-[24px] font-semibold tracking-[-0.016em] text-graphite">{plan.name}</h2>
              <p class="mt-1 text-[15px] text-slate">{plan.tagline}</p>

              <p class="mt-8 flex flex-wrap items-baseline gap-x-2">
                <span class="text-[44px] font-semibold leading-none tracking-[-0.035em] tabular-nums text-graphite">{plan.price}</span>
                {plan.priceUnit && <span class="text-[15px] text-slate">{plan.priceUnit}</span>}
              </p>
              <p class="mt-2 text-[13px] text-slate">{plan.floor}</p>

              <a
                href={plan.cta.href}
                data-join-open={plan.cta.joinOpen ? "" : undefined}
                class={`btn mt-8 w-full ${plan.featured ? "btn-primary" : "btn-light"}`}
              >
                {plan.cta.label}
              </a>

              <ul class="mt-8 space-y-3 border-t border-hairline pt-8">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-[15px] text-graphite">
                    <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-4 w-4 flex-none text-brand-500" aria-hidden="true">
                      <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <PriceSimulator />

    <!-- Inclus partout -->
    <section class="px-5 py-24 sm:px-6 sm:py-32">
      <div class="mx-auto max-w-[820px] text-center">
        <p data-reveal class="t-eyebrow">Inclus dans tous les plans</p>
        <h2 data-reveal style="transition-delay: 60ms" class="t-section mt-3 text-balance text-graphite">
          La même base, pour tout le monde.
        </h2>
      </div>

      <div class="mx-auto mt-14 grid max-w-[1080px] gap-x-8 gap-y-10 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
        {
          included.map((item, i) => (
            <div data-reveal style={`transition-delay: ${i * 80}ms`} class="border-t border-hairline pt-7">
              <Icon name={item.icon} class="h-7 w-7 text-brand-500" strokeWidth={1.6} />
              <h3 class="mt-5 text-[19px] font-semibold tracking-[-0.012em] text-graphite">{item.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-slate">{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FAQ tarifs -->
    <section class="px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="mx-auto max-w-[820px]">
        <div class="text-center">
          <p data-reveal class="t-eyebrow">Questions de tarifs</p>
          <h2 data-reveal style="transition-delay: 60ms" class="t-section mt-3 text-balance text-graphite">
            Tout ce qu'on nous demande.
          </h2>
        </div>

        <ul class="mt-12 border-b border-hairline sm:mt-14">
          {
            faq.map((item, i) => (
              <li data-reveal style={`transition-delay: ${i * 50}ms`} class="border-t border-hairline">
                <details class="faq-item group">
                  <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-[17px] font-semibold tracking-[-0.01em] text-graphite sm:text-[19px]">
                    <span>{item.q}</span>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-mist text-graphite transition-colors group-hover:bg-cloud">
                      <svg class="faq-toggle h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                        <path d="M8 3v10M3 8h10" />
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-content-wrapper">
                    <div>
                      <p class="pb-6 pr-4 text-[15px] leading-relaxed text-slate sm:pr-14 sm:text-base">{item.a}</p>
                    </div>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- CTA final -->
    <section class="px-5 pb-24 sm:px-6 sm:pb-32">
      <div data-reveal class="tile mx-auto max-w-[1080px] px-6 py-20 text-center sm:px-12 sm:py-24">
        <h2 class="t-section mx-auto max-w-[720px] text-balance text-graphite">Pas sûr du plan qu'il vous faut ?</h2>
        <p class="t-lead mx-auto mt-5 max-w-[560px] text-pretty text-slate">
          Présentez-nous votre asso dans un court formulaire. On vous répond avec un tarif, des conseils, ou un accès — sans engagement.
        </p>
        <div class="mt-9 flex flex-col items-center justify-center gap-x-8 gap-y-5 sm:flex-row">
          <CTAButton href="/inscription" joinOpen size="lg">S'inscrire</CTAButton>
          <CTAButton href="mailto:contact@konclav.ch" variant="link">Poser une question</CTAButton>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
