---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CTAButton from "../components/CTAButton.astro";
---

<Layout title="Page introuvable — Konclav" description="Cette page n'existe pas ou plus." noindex={true}>
  <Navbar />
  <main id="main">
    <section class="flex min-h-[78vh] items-center justify-center px-5 pt-[120px] pb-24 sm:px-6">
      <div class="mx-auto max-w-[640px] text-center">
        <p data-reveal class="t-eyebrow">Erreur 404</p>
        <p data-reveal style="transition-delay: 60ms" class="text-gradient-brand mt-2 text-[clamp(6rem,18vw,10rem)] font-semibold leading-none tracking-[-0.05em]">
          404
        </p>
        <h1 data-reveal style="transition-delay: 120ms" class="mt-6 text-balance text-[28px] font-semibold tracking-[-0.018em] text-graphite sm:text-[34px]">
          Cette page n'existe pas (ou plus).
        </h1>
        <p data-reveal style="transition-delay: 160ms" class="t-lead mx-auto mt-4 max-w-[480px] text-pretty text-slate">
          Le lien a peut-être bougé, ou n'a jamais existé. Aucun stress — on
          vous remet sur les rails.
        </p>
        <div data-reveal style="transition-delay: 200ms" class="mt-9 flex flex-col items-center justify-center gap-x-8 gap-y-5 sm:flex-row">
          <CTAButton href="/" size="lg">Retour à l'accueil</CTAButton>
          <CTAButton href="/inscription" variant="link">S'inscrire</CTAButton>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
